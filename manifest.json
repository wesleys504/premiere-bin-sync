{
  "id": "com.wesley.binsync",
  "name": "Bin Sync",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "premierepro",
    "minVersion": "25.2.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "binSyncPanel",
      "label": { "default": "Bin Sync" },
      "minimumSize": { "width": 240, "height": 300 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 420 },
      "preferredFloatingSize": { "width": 340, "height": 480 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.svg", "scale": [1, 2], "theme": ["all"] }
      ]
    },
    {
      "type": "command",
      "id": "syncSelectedBin",
      "label": { "default": "Sync Selected Bin" }
    },
    {
      "type": "command",
      "id": "syncAllBins",
      "label": { "default": "Sync All Linked Bins" }
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.svg",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["pluginList"]
    }
  ]
}
